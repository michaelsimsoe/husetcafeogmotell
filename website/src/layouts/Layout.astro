---
import '../styles/global.css';
import Ridge from '@components/Ridge.astro';
import Confirm from '@components/Confirm.astro';
import PageLink from '@components/PageLink.astro';
import { hoursIn, phoneIn, site } from '@data/site';
import { location } from '@data/location';
import { src } from '@data/credits';
import { withBase } from '@lib/base';
import { indexable } from '@lib/env';
import { directionsAttrs } from '@lib/format';
import { noticeIn } from '@lib/notice';
import { localeInfo, toLocale } from '@i18n/locales';
import { alternates, isNoindex, pathOf, switchTargets, type PageKey } from '@i18n/routes';
import { ui } from '@i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Which page this is (src/i18n/routes.ts). Omit only for pages outside the registry, like 404. */
  page?: PageKey;
  /** Keep this page out of search results regardless of environment. */
  noindex?: boolean;
  /** Social preview image, root-relative. */
  image?: string;
  /** Structured data for this page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, page, noindex = false, image = src('huset-facade-sun', 1536), jsonLd } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const ownPath = page && pathOf(page, locale);
if (page && ownPath === undefined) throw new Error(`Page «${page}» has no ${locale} path in src/i18n/routes.ts, but ${Astro.url.pathname} renders it.`);

const homePath = withBase(pathOf('home', locale)!);
const hash = (id: string) => (page === 'home' ? `#${id}` : `${homePath}#${id}`);
const menuPath = pathOf('menu', locale);
const contactPath = pathOf('contact', locale)!;
const nav = [
  // Until the menu is translated, Food leads to the dishes on the home page.
  { href: menuPath ? withBase(menuPath) : hash(t.sections.food), label: t.nav.food, current: page === 'menu' },
  { href: hash(t.sections.rooms), label: t.nav.rooms, current: false },
  { href: hash(t.sections.gatherings), label: t.nav.gatherings, current: false },
  { href: hash(t.sections.findUs), label: t.nav.findUs, current: false },
  { href: withBase(contactPath), label: t.nav.contact, current: page === 'contact' || page === 'thanks' },
];

const abs = (path: string) => new URL(withBase(path), Astro.site).href;
// Pages outside the registry (404) fall back to the URL. With build.format 'file' the build-time pathname ends in `.html`; canonical URLs have no suffix or trailing slash.
const urlPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = ownPath !== undefined ? abs(ownPath) : new URL(urlPath, Astro.site).href;
const hidden = noindex || (page !== undefined && isNoindex(page));
const alts = page && !hidden ? alternates(page) : [];
const hreflang = alts.length > 1 ? [...alts.map((a) => ({ lang: localeInfo[a.locale].lang, href: abs(a.path) })), { lang: 'x-default', href: abs(alts[0].path) }] : [];
const switches = switchTargets(page ?? 'home', locale).map((s) => ({
  href: withBase(s.path),
  lang: localeInfo[s.locale].lang,
  label: s.fallback ? ui(s.locale).homeInThisLanguage : localeInfo[s.locale].name,
}));
const ogImage = new URL(image, Astro.site).href;
const robots = indexable && !hidden ? undefined : 'noindex';
// `<` is escaped so the JSON can never close its own <script>.
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const hours = hoursIn(locale);
const notice = site.notice && noticeIn(site.notice, locale);
const hoursJson = json(hours.days.map(({ day, label, short, open, close, closed }) => ({ day, label, short, open, close, closed })));
---

<!doctype html>
<html lang={localeInfo[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <meta name="theme-color" content="#f5f6f2" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeInfo[locale].og} />
    {alts.filter((a) => a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={localeInfo[a.locale].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={json(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href={`#${t.sections.main}`}>{t.skip}</a>
    {
      site.notice && notice && (
        <aside class="notice on-spruce" aria-label={t.notice} data-until={site.notice.until}>
          <p class="wrap" lang={notice.lang}>{notice.text}</p>
        </aside>
      )
    }
    {/* Removes the notice after its last day, between builds. Same rule as activeNotice() in lib/notice.ts. */}
    {
      site.notice?.until && (
        <script is:inline>
          (function () {
            var n = document.currentScript.previousElementSibling;
            var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Oslo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
            if (n && n.dataset.until < today) n.remove();
          })();
        </script>
      )
    }
    <header class="tb">
      <div class="wrap tb-row">
        <a class="wm" href={homePath} aria-label={t.toHome(site.name)}>
          <span class="wm-name">Huset</span>
          <span class="wm-sub">Café &amp; Motell</span>
        </a>
        <nav class="tb-nav" aria-label={t.mainNav}>
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={n.current ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav class="tb-lang" aria-label={t.language}>
          <ul>
            {
              switches.map((s) => (
                <li>
                  <a href={s.href} hreflang={s.lang} lang={s.lang}>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="tb-phone" href={site.contact.phoneHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.6 3.5h2.6l1.4 4.1-2 1.4a12 12 0 0 0 6.4 6.4l1.4-2 4.1 1.4v2.6a1.8 1.8 0 0 1-1.9 1.8A16.6 16.6 0 0 1 4.8 5.4a1.8 1.8 0 0 1 1.8-1.9Z"></path>
          </svg>
          <span><span class="sr-only">{t.call} </span>{phoneIn(locale)}</span>
        </a>
      </div>
    </header>

    <main id={t.sections.main} tabindex="-1">
      <slot />
    </main>

    <footer class="on-spruce">
      <Ridge from={0} to={1} mirror bleed height="clamp(36px, 5vw, 64px)" class="ft-ridge" />
      <div class="wrap ft g12">
        <div class="md:col-[1/5]">
          <img class="ft-logo" src={withBase('/img/huset-logo-mask.png')} width="267" height="160" alt="" />
          <h2>{site.name}</h2>
          <address class="soft not-italic">
            {location.address.street}, {location.address.postcode} {location.address.postalPlace}<br />
            {location.address.municipality} · {t.byRoad(site.place.road)}
          </address>
        </div>
        <div class="md:col-[5/9] mt-6 md:mt-0">
          <ul class="ft-list">
            <li><a href={site.contact.phoneHref}>{t.call} {phoneIn(locale)}</a></li>
            <li><a href={site.contact.emailHref}>{site.contact.email}</a></li>
            <li><PageLink page="contact">{t.message}</PageLink></li>
            <li><a href={site.contact.facebook}>Facebook</a></li>
            <li><a href={site.links.directions} {...directionsAttrs}>{t.directions}</a></li>
          </ul>
        </div>
        <div class="md:col-[9/13] mt-6 md:mt-0">
          <p class="label">{t.hours}</p>
          <ul class="ft-list num mt-2">
            {
              hours.groups.map((g) => (
                <li>
                  {g.label} {g.time}
                </li>
              ))
            }
          </ul>
          <p class="mt-2"><Confirm confirmed={hours.confirmed} /></p>
        </div>
        <p class="ft-meta">
          <PageLink page="credits" current={page === 'credits'}>{t.credits}</PageLink>
          <PageLink page="privacy" current={page === 'privacy'}>{t.privacy}</PageLink>
          {
            switches.map((s) => (
              <a class="ft-lang" href={s.href} hreflang={s.lang} lang={s.lang}>
                {s.label}
              </a>
            ))
          }
        </p>
      </div>
    </footer>

    <script type="application/json" id="opening-hours" set:html={hoursJson} />
    <script>
      import { mountSite } from '../scripts/site';
      mountSite();
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .notice p { padding-block: 0.625rem; font-size: 1rem; line-height: 1.5; text-wrap: pretty; }
  .ft-ridge { padding-top: clamp(2rem, 4vw, 3.5rem); }
</style>
