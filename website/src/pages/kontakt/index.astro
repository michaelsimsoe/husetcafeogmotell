---
import Layout from '@layouts/Layout.astro';
import Ridge from '@components/Ridge.astro';
import Confirm from '@components/Confirm.astro';
import ContactForm from '@components/ContactForm.astro';
import Arrow from '@components/Arrow.astro';
import { site } from '@data/site';
import { location } from '@data/location';
import { directionsAttrs, groupsLine } from '@lib/format';
---

<Layout
  title="Kontakt oss – Huset Café & Motell i Korgen"
  description={`Spørsmål om rom, selskap eller maten? Skriv til oss, ring ${site.contact.phone} eller send e-post til ${site.contact.email}.`}
  current="kontakt"
>
  <div class="wrap g12 pg-head">
    <h1 class="display lg:col-[1/10]">La oss ta <em>en prat</em></h1>
    <p class="lede mt-5 lg:col-[1/8]">
      Lurer du på noe om overnattingen? Tenker du at du skal ha en fest eller ordne en bedre middag? Eller vil du kanskje
      bare ha kanelbolleoppskriften vår?
    </p>
    <Ridge from={0.4} to={0.95} start={0} end={0.6} height="clamp(32px, 4vw, 52px)" class="mt-8 lg:mt-10" />
  </div>

  <div class="wrap g12 kt">
    <section class="lg:col-[1/8]" aria-labelledby="skriv">
      <h2 id="skriv" class="h3 kt-h">Skriv til oss</h2>
      <ContactForm />
    </section>

    <aside class="lg:col-[9/13]" aria-labelledby="direkte">
      <h2 id="direkte" class="h3 kt-h">Eller ta kontakt direkte</h2>
      <dl class="kt-ways">
        <div>
          <dt class="label">Ring oss</dt>
          <dd>
            <a class="kt-phone num" href={site.contact.phoneHref}>{site.contact.phone}</a>
            <p class="soft num mt-1">
              <span data-hours="text">Åpent {groupsLine.toLowerCase()}</span>{' '}
              <Confirm confirmed={site.hours.confirmed} />
            </p>
          </dd>
        </div>
        <div>
          <dt class="label">E-post</dt>
          <dd><a href={site.contact.emailHref}>{site.contact.email}</a></dd>
        </div>
        <div>
          <dt class="label">Facebook</dt>
          <dd><a href={site.contact.facebook}>Huset Café &amp; Motell på Facebook</a></dd>
        </div>
        <div>
          <dt class="label">Kom innom</dt>
          <dd>
            <address>
              {location.address.street}<br />
              {location.address.postcode} {location.address.postalPlace}, ved {site.place.road}
            </address>
            <a class="go" href={site.links.directions} {...directionsAttrs}>Veibeskrivelse <Arrow /></a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</Layout>
