---
import Home from '@components/pages/Home.astro';
import type { HomeCopy } from '@components/pages/home';
import { site } from '@data/site';

const r = site.rooms;
const v = site.venues;
const ox = site.landscape.oksskolten;
const tunnel = site.landscape.korgfjelltunnelen;

const copy: HomeCopy = {
  title: 'Huset Café & Motell – mat og overnatting ved E6 i Korgen',
  description: `Familiedrevet kafé og motell ved E6 i Korgen, Hemnes. Grill, pizza og kaffe, ${r.count} rom med frokost, selskap og møterom. Ring ${site.contact.phone}.`,
  hero: {
    h1: ['Mat og husrom ', 'midt i Korgen'],
    stand: 'Familiedrevet kafé og motell ved E6. Her spiser bygdefolk middag, familier tar en pizza, og reisende får mat og en seng for natten.',
  },
  today: { h: 'I dag', callUs: 'Ring oss', food: 'Se menyen', roomsFrom: 'Rom fra' },
  food: {
    h: ['Grill, pizza og ', 'en kopp kaffe'],
    lede: 'Middag, en pizza å dele eller bare kaffe på veien videre. Her er et utvalg fra menyen – hele menyen med alle retter og allergener har sin egen side.',
    all: 'Se hele menyen',
    allergens: 'Allergener',
  },
  rooms: {
    h: ['Et rom for natten, ', 'frokost om morgenen'],
    facts: { rooms: 'Rom', breakfast: 'Frokost', included: 'Inkludert', checkIn: 'Innsjekk', checkOut: 'Utsjekk', perNight: 'Per natt', from: 'fra' },
    toBook: 'for å bestille rom',
  },
  gatherings: {
    h: ['Når det er noe ', 'å samles om'],
    occasions: 'Bryllup og julebord, konfirmasjon og dåp, minnestund og klassefest.',
    meetingRooms: 'Møterom',
    orMessage: 'eller send oss en melding',
  },
  korgen: {
    h: ['Korgen, ', 'før og nå'],
    then: { caption: 'Korgen og Røssåga', date: '1947–49' },
    now: { caption: 'Korgen sentrum fra Røssåga', date: 'mai 2008' },
    peaksDate: 'mai 2009',
    ridgeNote: 'Den grønne streken er fjellet over Korgen, tegnet etter dette bildet. Den samme linja går igjen gjennom hele siden.',
  },
  around: { h: ['Rundt ', 'Huset'], lede: 'Butikk, apotek og drivstoff ligger et steinkast unna.' },
  findUs: {
    h: ['Finn ', 'fram'],
    address: 'Adresse',
    directionsNote: 'Veibeskrivelsen ender på parkeringen mellom huset og E6.',
    today: 'i dag',
    phone: 'Telefon',
  },
  map: 'Kart',
};
---

<Home copy={copy}>
  <Fragment slot="rooms">
    <p class="lede">
      Motellet har {r.count} rom: dobbeltrom med to senger som kan stå hver for seg eller skyves sammen, og to enkeltrom. Alle
      dobbeltrommene kan også leies som enkeltrom.
    </p>
    <p>Rommene har TV og rene bad. Frokosten er en tradisjonell norsk frokost, selvbetjent i eget frokostrom.</p>
    <p>
      Rom bestilles på telefon eller med en melding. Kommer du sent, kan ankomst avtales. Betaling skjer ved ankomst, om ikke
      annet er avtalt.
    </p>
    <p>Er det fullt, hjelper vi deg å finne et annet sted i nærheten.</p>
  </Fragment>

  <p class="lede" slot="gatherings">
    Det er plass til {v.capacity} gjester i spisesalen. Vi lager mat til selskapet – koldtbord, varmmat og snitter{
      v.cakes && <> – og {v.cakes.toLowerCase()}</>
    }.
  </p>

  <Fragment slot="korgen">
    <p>
      Røssåga renner gjennom Korgen. Elva er 50 kilometer lang og går fra Røssvatnet nordover til Sørfjorden
      ved Bjerka.
    </p>
    <p>
      E6 går gjennom Korgfjellet i {tunnel.name}, som er om lag 8,5 kilometer lang og ble åpnet i {tunnel.opened}. Fjellet
      ligger i snitt rundt 600 meter over havet.
    </p>
    <p>
      Om lag {ox.kmFromHuset} kilometer {ox.bearing.nb} for Huset ligger Okstindan, med {ox.name} – 1&nbsp;916 meter over havet og
      Nord-Norges høyeste fjell.
    </p>
  </Fragment>
</Home>
