---
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg
  class:list={['arr', cls]}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d="M2.75 8h10.5M8.75 3.5 13.25 8l-4.5 4.5"></path></svg
>
