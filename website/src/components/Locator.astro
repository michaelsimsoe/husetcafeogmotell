---
import { norway as m, profile as p, distances, stretchKm } from '@lib/locator';
import PageLink from './PageLink.astro';
import { toLocale } from '@i18n/locales';
import { ui } from '@i18n/ui';

const locale = toLocale(Astro.currentLocale);
const id = ui(locale).sections.where;
const t = {
  nb: {
    h: ['Her ligger ', 'Korgen', ''],
    lede: 'Korgen ligger i Hemnes på Helgeland, ved E6 mellom Mosjøen og Mo i Rana. Huset står ved veien, ca.\u00a02\u00a0km nord for Korgfjelltunnelen.',
    map: 'Kart over Norge. Veien går fra Trondheim nordover til Bodø, og Korgen ligger mellom Mosjøen og Mo i Rana.',
    profile: `Høydeprofil langs E6 fra Mosjøen til Mo i Rana, ${stretchKm} km. Veien går i tunnel gjennom Korgfjellet, og Huset ligger like nord for tunnelen.`,
    masl: 'moh.',
    distances: 'Kjøreavstand til Huset',
    about: 'ca.',
    note: 'Avstander og kjøretider er omtrentlige. Høydene er overdrevet, og veien i tunnelene er stiplet.',
    roads: 'Veidata fra',
    sources: 'Kilder og lisenser',
  },
  en: {
    h: ['Where ', 'Korgen', ' is'],
    lede: 'Korgen is in Hemnes, in Helgeland, on the E6 between Mosjøen and Mo i Rana. Huset stands by the road, about\u00a02\u00a0km north of the Korgfjell Tunnel.',
    map: 'Map of Norway. The road runs north from Trondheim to Bodø, and Korgen lies between Mosjøen and Mo i Rana.',
    profile: `Elevation profile along the E6 from Mosjøen to Mo i Rana, ${stretchKm} km. The road runs in a tunnel through Korgfjellet, and Huset is just north of the tunnel.`,
    masl: 'm a.s.l.',
    distances: 'Driving distances to Huset',
    about: 'about',
    note: 'Distances and driving times are approximate. Heights are exaggerated, and the road is dashed where it runs in a tunnel.',
    roads: 'Road data from',
    sources: 'Sources and licences',
  },
}[locale];

const side: Record<string, 'l' | 'r' | 'b'> = { trondheim: 'b', mosjoen: 'l', korgen: 'r', moirana: 'l', bodo: 'l' };
const kmTicks = p.ticks.filter((t) => t > 0 && t < stretchKm - 4);
---

<section id={id} class="sec loc" aria-labelledby={`${id}-h`} data-loc>
  <div class="wrap g12 loc-grid">
    <div class="loc-head">
      <h2 id={`${id}-h`} class="h2">{t.h[0]}<em>{t.h[1]}</em>{t.h[2]}</h2>
      <p class="lede mt-5">{t.lede}</p>
    </div>

    <figure
      class="loc-map"
      role="img"
      aria-label={t.map}
    >
      <div class="loc-map-box" style={`aspect-ratio: ${m.aspect}`}>
        <svg
          class="loc-map-svg"
          viewBox={m.viewBox}
          data-full={m.full}
          data-loc-map
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
          focusable="false"
        >
          <path class="loc-nb" d={m.neighbours}></path>
          <path class="loc-land" d={m.land}></path>
          <path class="loc-road" d={m.road} data-loc-road></path>
          <path class="loc-stretch" d={m.stretch} data-at={m.stretchAt} data-loc-stretch></path>
        </svg>

        <span class="loc-tag" style={`left:${m.e6Tag.left}%;top:${m.e6Tag.top}%`} data-at={m.e6Tag.at} aria-hidden="true">E6</span>
        {
          m.cities.map((c) => (
            <span
              class:list={['loc-city', `loc-city--${side[c.id]}`, { 'loc-city--here': c.id === 'korgen' }]}
              style={`left:${c.left}%;top:${c.top}%`}
              data-at={c.at}
              aria-hidden="true"
            >
              <i class="loc-dot" />
              <span class="loc-name">{c.name}</span>
            </span>
          ))
        }

        <svg class="loc-inset" viewBox={m.full} aria-hidden="true" focusable="false">
          <path d={m.inset}></path>
          <rect x={m.region.x} y={m.region.y} width={m.region.w} height={m.region.h}></rect>
        </svg>
      </div>
    </figure>

    <figure
      class="loc-prof"
      role="img"
      aria-label={t.profile}
    >
      <div class="loc-prof-box">
        <svg class="loc-prof-svg" viewBox={p.viewBox} preserveAspectRatio="none" data-loc-profile aria-hidden="true" focusable="false">
          <line class="loc-600" x1="0" x2={p.w} y1={p.y600} y2={p.y600}></line>
          <path class="loc-terrain" d={p.terrain}></path>
          <path class="loc-open" d={p.open}></path>
          <path class="loc-tunnel" d={p.tunnel}></path>
        </svg>
        <span class="loc-pl loc-pl--600" style={`top:${((p.y600 / 660) * 100).toFixed(1)}%`} aria-hidden="true">600 {t.masl}</span>
        <span class="loc-pl loc-pl--peak" style={`left:${p.peak.x}%;top:${p.peak.y}%`} aria-hidden="true">Korgfjellet</span>
        <span class="loc-pl loc-pl--tunnel" style={`left:${p.tunnelAt.x}%;top:${p.tunnelAt.y}%`} aria-hidden="true">Korgfjelltunnelen</span>
        <span class="loc-huset" style={`left:${p.huset.x}%;top:${p.huset.y}%`} aria-hidden="true">
          <span class="loc-huset-name">Huset</span>
        </span>
      </div>
      <div class="loc-axis" aria-hidden="true">
        {kmTicks.map((t) => <span class="loc-tick" style={`left:${p.pctX(t)}%`}>{t}</span>)}
        <span class="loc-end loc-end--s">Mosjøen</span>
        <span class="loc-end loc-end--n">Mo i Rana <span class="soft num">{stretchKm} km</span></span>
      </div>
    </figure>

    <div class="loc-dist">
      <h3 class="h3 loc-dist-h">{t.distances}</h3>
      <dl class="num">
        {
          distances.map((d) => (
            <div>
              <dt>{d.from}</dt>
              <dd>
                <span class="loc-km">
                  <small>{t.about}</small> {d.km} km
                </span>
                {d.min && <span class="loc-min">{t.about} {d.min} min</span>}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="loc-note">
        {t.note}{' '}
        {t.roads} <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>.{' '}
        <PageLink page="credits" hash={ui(locale).anchors.sources}>{t.sources}</PageLink>.
      </p>
    </div>
  </div>

  <svg class="loc-fly" data-loc-fly aria-hidden="true" focusable="false">
    <path data-from={m.stretchPts} data-to={p.road}></path>
  </svg>
</section>
