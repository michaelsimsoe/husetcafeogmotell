---
/**
 * «bekreftes» mark for facts the owners have not confirmed yet.
 * Renders nothing once the matching `confirmed` flag is ticked in the CMS.
 */
interface Props {
  confirmed: boolean;
  /** Optional longer note shown after the mark. */
  note?: string;
  class?: string;
}
import { toLocale } from '@i18n/locales';

const { confirmed, note, class: cls } = Astro.props;
const mark = toLocale(Astro.currentLocale) === 'en' ? 'to be confirmed' : 'bekreftes';
---

{!confirmed && <><span class:list={['bk', cls]}>{mark}</span>{note && <span class="bk-note"> {note}</span>}</>}
