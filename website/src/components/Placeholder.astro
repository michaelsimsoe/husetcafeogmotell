---
import { toLocale } from '@i18n/locales';

interface Props {
  need: string;
  detail?: string;
  ratio?: string;
  class?: string;
}
const { need, detail, ratio = '4 / 3', class: cls } = Astro.props;
const label = toLocale(Astro.currentLocale) === 'en' ? 'Placeholder' : 'Plassholder';
---

<figure class:list={['hold', 'hold-box', cls]} style={`--ratio:${ratio}`}>
  <span class="hold-tick" aria-hidden="true"></span><span class="hold-tick" aria-hidden="true"></span><span
    class="hold-tick"
    aria-hidden="true"></span><span class="hold-tick" aria-hidden="true"></span>
  <figcaption class="hold-text"><b>{label}: {need}</b>{detail}</figcaption>
</figure>
