---
import { allergenName, kr, krText, type Dish } from '@data/menu';
import { toLocale } from '@i18n/locales';
import Tr from './Tr.astro';

interface Props {
  dish: Dish;
  desc?: boolean;
}

const { dish, desc = true } = Astro.props;
// Dishes come from the CMS in Norwegian; `Tr` gives the page's language from the translation memory, or marks the Norwegian.
const locale = toLocale(Astro.currentLocale);
const allergensLabel = locale === 'en' ? 'allergens' : 'allergener';
const variants = dish.variants ?? [];
const price = variants.length === 0 ? dish.price : undefined;
---

<li class="dish">
  <div class="dish-line">
    <span class="dish-name"
      ><Tr text={dish.name} />{
        dish.allergens.length > 0 && (
          <>
            <span class="sr-only">, {allergensLabel}: {dish.allergens.map((code, i) => <>{i > 0 && ', '}<Tr text={allergenName(code)} /></>)}</span>
            <sup aria-hidden="true">{dish.allergens.join(',')}</sup>
          </>
        )
      }</span
    >
    {
      price !== undefined && (
        <>
          <span class="dish-lead" aria-hidden="true" />
          <span class="dish-price price">
            <span aria-hidden="true">{kr(price, locale)}</span>
            <span class="sr-only">{krText(price, locale)}</span>
          </span>
        </>
      )
    }
  </div>
  {
    desc && dish.description && (
      <p class="dish-desc">
        <Tr text={dish.description} />
      </p>
    )
  }
  {
    variants.length > 0 && (
      <ul class="dish-variants">
        {variants.map((v) => (
          <li class="dish-line">
            <span class="dish-name">
              <Tr text={v.label} />
            </span>
            <span class="dish-lead" aria-hidden="true" />
            <span class="dish-price price">
              <span aria-hidden="true">{kr(v.price, locale)}</span>
              <span class="sr-only">{krText(v.price, locale)}</span>
            </span>
          </li>
        ))}
      </ul>
    )
  }
</li>
