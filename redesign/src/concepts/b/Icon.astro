---
/**
 * Concept B pictograms. One grid (24 × 24), one stroke (2 px), round caps and joins.
 */
export type IconName =
  | 'spis'
  | 'seng'
  | 'mote'
  | 'ring'
  | 'pil'
  | 'sving'
  | 'tunnel'
  | 'pin'
  | 'epost'
  | 'klokke'
  | 'fjell'
  | 'elv'
  | 'butikk'
  | 'drivstoff'
  | 'hake'
  | 'ut';

interface Props {
  name: IconName;
  /** Degrees; arrows point right at 0. */
  rotate?: number;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, rotate = 0, size = 24, class: cls, label } = Astro.props;

const paths: Record<IconName, string> = {
  spis: '<path d="M6 3v5.5a2.5 2.5 0 0 0 5 0V3M8.5 3v5.5M8.5 11v10M18 21V3c-2.2 1.4-3.3 4.4-3.3 8.4V13H18"/>',
  seng: '<path d="M3 5v14M3 15h18v4M21 15v-2.5a2.5 2.5 0 0 0-2.5-2.5H11v5"/><circle cx="7" cy="12.4" r="1.6"/>',
  mote: '<path d="M3 13h18M6 13v7M18 13v7M4.5 13v-.5a3 3 0 0 1 6 0v.5M13.5 13v-.5a3 3 0 0 1 6 0v.5"/><circle cx="7.5" cy="6.5" r="2"/><circle cx="16.5" cy="6.5" r="2"/>',
  ring: '<path d="M5.5 3.5h3l1.8 4.6-2.3 1.6a11.5 11.5 0 0 0 6.3 6.3l1.6-2.3 4.6 1.8v3a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 3.5 5.6a2 2 0 0 1 2-2.1z"/>',
  pil: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  sving: '<path d="M7 21v-7a4 4 0 0 1 4-4h9M16 6l4 4-4 4"/>',
  tunnel: '<path d="M2 20h20M4 20v-8a8 8 0 0 1 16 0v8M12 20v-2.5M12 15v-1.5"/>',
  pin: '<path d="M12 21.5s-6.5-6-6.5-11.5a6.5 6.5 0 0 1 13 0c0 5.5-6.5 11.5-6.5 11.5z"/><circle cx="12" cy="10" r="2.3"/>',
  epost: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/>',
  klokke: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  fjell: '<path d="M2 20 9 8l4 6 2.5-3.5L22 20z"/>',
  elv: '<path d="M3 9c3 0 3 2 6 2s3-2 6-2 3 2 6 2M3 15c3 0 3 2 6 2s3-2 6-2 3 2 6 2"/>',
  butikk: '<path d="M4.5 9h15l-1 11h-13zM8.5 9V7a3.5 3.5 0 0 1 7 0v2"/>',
  drivstoff: '<path d="M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M3 21h12M4 10h10M14 8h2.5A1.5 1.5 0 0 1 18 9.5v7a1.5 1.5 0 0 0 3 0V8l-3-3"/>',
  hake: '<path d="M5 12.5 9.5 17 19 7.5"/>',
  ut: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
};

const style = rotate ? `transform: rotate(${rotate}deg)` : undefined;
---

<svg
  class:list={['ic', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={style}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
